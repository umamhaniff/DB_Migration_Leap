    "from glob import glob\n",
    "import os\n",
    "\n",
    "# Scan semua file pickle\n",
    "pickle_files = glob('**/*.pkl', recursive=True)\n",
    "print(\"Daftar file yang bisa kamu periksa:\")\n",
    "print(\"-\" * 40)\n",
    "for i, f in enumerate(pickle_files):\n",
    "    print(f\"[{i}] {f}\")\n",
    "print(\"-\" * 40)\n",
    "print(\"Silakan pilih nomor index untuk digunakan di Cell 2.\")"
   ]
