# DATABASE CONFIGURATION
# Copy file ini menjadi .env dan sesuaikan dengan credential database Anda

# Database Host
DB_HOST=localhost

# Database Port (default MySQL: 3306)
DB_PORT=3306

# Database User
DB_USER=root

# Database Password
DB_PASS=

# Database Name - OLD (dataleap_v5_example)
DB_OLD=dataleap_v5_example

# Database Name - NEW (dataleap_v5_migration)
DB_NEW=dataleap_v5_migration

# ===== CONTOH KONFIGURASI =====
# Jika menggunakan remote server:
# DB_HOST=192.168.1.100
# DB_PORT=3306
# DB_USER=migration_user
# DB_PASS=super_secret_password

# Jika menggunakan Docker:
# DB_HOST=db-container
# DB_PORT=3306
# DB_USER=root
# DB_PASS=docker_password
